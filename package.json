{
  "name": "html-ouput-kit",
  "version": "1.0.1",
  "description": "A utility to convert HTML content to PDF and DOCX with Tailwind CSS support",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "types"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "rimraf output && ts-node-dev --respawn src/index.ts",
    "build": "rimraf dist && tsc",
    "prepare": "npm run build",
    "prepublish": "npm run build"
  },
  "keywords": [
    "html",
    "pdf",
    "docx",
    "converter",
    "tailwind",
    "puppeteer",
    "playwright"
  ],
  "author": "Milton Black, ArziBlack",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "html-docx-js": "^0.3.1",
    "playwright": "^1.51.0",
    "puppeteer": "^24.4.0",
    "tailwind-to-inline": "^1.0.5",
    "tailwindinline": "https://github.com/ArziBlack/tailwindinline/releases/download/0.3.7-beta.8/tailwindinline-v0.3.7-beta.8.tgz"
  },
  "devDependencies": {
    "@types/html-docx-js": "^0.3.4",
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArziBlack/html-ouput-kit.git"
  },
  "bugs": {
    "url": "https://github.com/ArziBlack/html-ouput-kit/issues"
  },
  "homepage": "https://github.com/ArziBlack/html-ouput-kit#readme"
}
